{
  "name": "nihongoesfar",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal Japanese reference and practice notebook. White pages, readable Japanese, and direct access to every exercise. No accounts, studied-status tracking, review schedules, streaks, or saved answer history.",
  "homepage": "https://github.com/andiliewantorosusanto/nihongoesfar#readme",
  "bugs": {
    "url": "https://github.com/andiliewantorosusanto/nihongoesfar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andiliewantorosusanto/nihongoesfar.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "update:compounds": "python3 scripts/update-compounds.py",
    "build:static": "npm run build",
    "dev:static": "npm run dev",
    "test:static": "npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
