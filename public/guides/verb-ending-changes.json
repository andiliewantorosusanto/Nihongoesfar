    {
      "heading": "Using the changed ending",
      "columns": ["Rule", "Example"],
      "rows": [
        [
          {
            "text": "Add ます, ません, ました, or ませんでした to the ます-stem.",
            "reading": ""
          },
          {
            "text": "泳ぐ → 泳ぎ → 泳ぎます / 泳ぎません / 泳ぎました / 泳ぎませんでした",
            "reading": ""
          }
        ],
        [
          {
            "text": "Add ながら to the ます-stem.",
            "reading": ""
          },
          {
            "text": "泳ぐ → 泳ぎ → 泳ぎながら",
            "reading": ""
          }
        ],
        [
          {
            "text": "For past negative, replace ない with なかった.",
            "reading": ""
          },
          {
            "text": "泳がない → 泳がなかった",
            "reading": ""
          }
        ],
        [
          {
            "text": "Exception: 行く uses って / った.",
            "reading": ""
          },
          {
            "text": "行く → 行って / 行った",
            "reading": ""
          }
        ]
      ]
    }
  ],
  "ichidan": [
    {
      "heading": "Ending changes · drop the final る",
      "columns": ["Form", "Rule", "Example"],
      "rows": [
        [
          {
            "text": "ます-stem",
            "reading": ""
          },
          {
            "text": "Drop る.",
            "reading": ""
          },
          {
            "text": "食べる → 食べ",
            "reading": ""
          }
        ],
        [
          {
            "text": "Polite forms",
            "reading": ""
          },
          {
            "text": "Add ます, ません, ました, or ませんでした to the stem.",
            "reading": ""
          },
          {
            "text": "食べます / 食べません / 食べました / 食べませんでした",
            "reading": ""
          }
        ],
        [
          {
            "text": "Negative / past negative",
            "reading": ""
          },
          {
            "text": "Add ない / なかった to the stem.",
            "reading": ""
          },
          {
            "text": "食べない / 食べなかった",
            "reading": ""
          }
        ],
        [
          {
            "text": "て-form / past",
            "reading": ""
          },
          {
            "text": "Add て / た to the stem.",
            "reading": ""
          },
          {
            "text": "食べて / 食べた",
            "reading": ""
          }
        ],
        [
          {
            "text": "ながら",
            "reading": ""
          },
          {
            "text": "Add ながら to the stem.",
            "reading": ""
          },
          {
            "text": "食べながら",
            "reading": ""
          }
        ]
      ]
    }
  ],
